# PORT
PORT=8000

# CORS ORIGIN URL (use your domain or http://localhost in Docker)
CORS_ORIGIN=http://localhost

# MONGODB URL
MONGODB_URI=
DB_NAME=
PUBLIC_NOTES_VECTOR_COLLECTION=
PRIVATE_NOTES_VECTOR_COLLECTION=

# NODE ENVIRONMENT (development or production)
NODE_ENV=production

# Access Token
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d

# Refresh Token
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Redis (overridden by docker-compose environment, but kept for reference)
REDIS_HOST=redis
REDIS_PORT=6379
